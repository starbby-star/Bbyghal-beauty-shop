# Supabase (required for secure staff login & member sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# One-time PIN seeding (GitHub Secrets / local only — never commit real values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional — only if using npm run seed:pins instead of 002_seed_staff_pins.sql
ADMIN_PIN=
EMPLOYEE_1_PIN=
EMPLOYEE_2_PIN=

# Optional
APP_URL=https://your-deployed-url.example
