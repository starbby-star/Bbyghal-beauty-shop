# Supabase (required for secure staff login & member sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# One-time PIN seeding (GitHub Secrets / local only — never commit real values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PIN=0000000000
EMPLOYEE_1_PIN=0000000000
EMPLOYEE_2_PIN=0000000000

# Optional
APP_URL=https://your-deployed-url.example
